{
  "schemaVersion": 1,
  "id": "trueadaptivemusic",
  "version": "${version}",
  "name": "True Adaptive Music",
  "description": "Experience dynamic music that adapts to what happens in Minecraft!",
  "authors": [],
  "contact": {
    "homepage": "https://liltojustice.github.io/TrueAdaptiveMusic/",
    "issues": "https://github.com/LilTOJustice/TrueAdaptiveMusic/issues",
    "sources": "https://github.com/LilTOJustice/TrueAdaptiveMusic"
  },
  "license": "GPL-3.0",
  "icon": "assets/trueadaptivemusic/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "liltojustice.trueadaptivemusic.client.TrueAdaptiveMusicClientInitializer"
    ],
    "main": [
      "liltojustice.trueadaptivemusic.TrueAdaptiveMusic"
    ],
    "modmenu": [
      "liltojustice.trueadaptivemusic.client.integration.TrueAdaptiveMusicModMenu"
    ]
  },
  "mixins": [
    {
      "config": "trueadaptivemusic.client.mixins.json",
      "environment": "client"
    }
  ],
  "suggests": {
    "trueadaptivemusicpackbrowser": "*"
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "trueadaptivemusicapi": "1.1.1"
  },
  "accessWidener": "trueadaptivemusic.accesswidener",
  "custom": {
    "mc-publish": {
      "loaders": ["fabric", "forge"]
    }
  }
}
